# Copiá este archivo a backend/.env y completalo.
# Generá APP_PASSWORD_HASH y JWT_SECRET con:  python scripts/hash_password.py

APP_USERNAME=admin
APP_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
# true cuando el sitio se sirva por HTTPS
COOKIE_SECURE=false

CORS_ORIGINS=["http://localhost:3000"]

# Caché (segundos)
CACHE_TTL_MACRO_SECONDS=21600
CACHE_TTL_PRICES_SECONDS=900
