# Copiá este archivo a backend/.env y completalo.
# Generá APP_PASSWORD_HASH y JWT_SECRET con:  python scripts/hash_password.py

APP_USERNAME=admin
APP_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
# true cuando el sitio se sirva por HTTPS
COOKIE_SECURE=false

CORS_ORIGINS=["http://localhost:3000"]

# Caché (segundos)
CACHE_TTL_MACRO_SECONDS=21600
CACHE_TTL_PRICES_SECONDS=900

# SEC EDGAR (resultados trimestrales). Gratis, pero la SEC exige identificarse con
# nombre y email de contacto, por ejemplo:  SEC_USER_AGENT="Juan Perez juan@ejemplo.com"
SEC_USER_AGENT=

# --- Agente 24/7 ---
# Zona horaria de las tareas programadas
AGENT_TIMEZONE=America/Argentina/Buenos_Aires
# Base de datos local (en Docker se usa /app/data automáticamente)
DATABASE_URL=sqlite+aiosqlite:///./data/market_analyst.db

# WhatsApp vía CallMeBot (gratis, mensajes a tu propio número). Ver DEPLOY.md.
# Número en formato internacional, ej. +5491112345678
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=
